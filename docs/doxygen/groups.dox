/** @file groups.dox
 *  @brief Группы документации проекта.
 */

/**
 * @defgroup ups Мониторинг ИБП
 * @brief Доменная модель и логика мониторинга состояния ИБП.
 *
 * Группа объединяет описание моделей ИБП, определение подключённой модели,
 * загрузку её спецификации, опрос и проверку контролируемых параметров,
 * формирование агрегированного состояния и хранение результатов мониторинга.
 */

/**
 * @defgroup snmp SNMP
 * @brief Компоненты взаимодействия с ИБП по протоколу SNMP.
 *
 * Группа содержит интерфейс и реализацию SNMP-клиента, типы протокола,
 * а также кодирование GET-запросов и декодирование GET-ответов.
 */

/**
 * @defgroup snmp_ber ASN.1 BER
 * @ingroup snmp
 * @brief Кодирование и декодирование ASN.1 BER-структур протокола SNMP.
 *
 * Группа содержит низкоуровневые средства чтения и записи BER-данных,
 * определения используемых тегов и вспомогательные функции кодирования.
 */

/**
 * @defgroup utils Вспомогательные компоненты
 * @brief Общие утилиты проекта.
 *
 * Группа объединяет средства работы с файловыми путями, INI-файлами
 * и строковыми значениями.
 */
