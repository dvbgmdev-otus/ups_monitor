#!/usr/bin/env bash
set -eEuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd -P)"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/scripts/lib/error_trap.sh"
setup_error_trap
# shellcheck disable=SC1091
source "$PROJECT_ROOT/scripts/lib/build_artifacts.sh"

get_binary_path
BINARY="$PROJECT_BIN_PATH"

check_output() {
    local name="$1"
    local expected="$2"
    local actual="$3"

    if [[ "$actual" != "$expected" ]]; then
        log_error "Test failed: $name"
        log_error "Expected: [$expected]"
        log_error "Actual:   [$actual]"
        exit 1
    fi

    log_ok "Passed: $name"
}

main() {
    if [[ ! -x "$BINARY" ]]; then
        log_error "Binary not found or not executable: $BINARY"
        exit 1
    fi

    local output
    output="$("$BINARY" --help)"

    local expected
    expected="Usage:
  $BINARY [--ip <IPv4>] [--port <number>]
  $BINARY --help

Options:
  --ip <IPv4>    UPS IPv4 address (default: 127.0.0.1)
  --port <number> SNMP UDP port, 1..65535 (default: 161)
  --help         Show this help and exit"

    check_output "help output" "$expected" "$output"

    log_ok "Self-check passed"
}

main "$@"
